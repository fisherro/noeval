; This is the "standard library" for my fexpr interpreter.
; Note that, by convention, `_` indicates an ignored value.
; NOTE THAT nil IS SPELT ()

(define get-current-environment
  (vau () env env))

; quote
; Use of this is not encouraged as it shouldn't be needed in a fexpr-based
; language.
(define q (vau (operand) _ operand))

#skip
; Library implementation of do
; Using invoke is likely incorrect here because the recursive call should get
; the same dynamic environment as the caller.
(define do-helper
  (vau (remaining last-result env) _
    ((nil? remaining)
     last-result
     (invoke do-helper
       (cons (rest remaining)
             (cons (eval (first remaining) env)
                   (cons env ())))))))

; Currently using the primitive do instead of this one.
; Using invoke is likely incorrect here because the recursive call should get
; the same dynamic environment as the caller.
(define do
  (vau expressions env
    ((nil? expressions)
     ()
     (invoke do-helper
       (cons (rest expressions)
             (cons (eval (first expressions) env)
                   (cons env ())))))))
#end

; A convenience macro.
; Since we use Church Booleans, you can essentially just remove the if.
; (if (nil? lyst) 0 1) -> ((nil? lyst) 0 1)
; Which is what this macro does: its expansion is its operands.
(define if (macro (vau operands _ operands)))

; Construct a list from the arguments without evaluating them
(define unevaluated-list (vau args _ args))

; or operative - short-circuiting logical or
; Returns the first truthy value, or the last value if all are falsy
; Uses Church Boolean evaluation for short-circuiting
(define or
  (vau operands env
    ((nil? operands)
     false  ; Empty or is false
     ((eval (first operands) env)
      true
      (eval (cons or (rest operands)) env)))))

; eval-list is a builtin. Defining it here created a cycle (through its local
; helper operative) on every call, and wrap calls it every time a wrapped
; operative is called.

; wrap takes an operative and returns a new operative that evaluates its arguments
(define wrap
  ; Here, the implicit env is the env where `define` was evaluated
  ; when loading the library.
  ; i.e. The global env
  (vau (operative) wrap-call-env
    ; Here, the implicit env is still the global env (the closure env of this
    ; vau).
    ; When this outer vau is called, i.e. when `wrap` is called, it creates a
    ; new env with the global env as its parent, `wrap-call-env` bound to the
    ; env where `wrap` was called, and `operative` bound to the argument of
    ; `wrap`. This new env becomes the implicit env.
    (do
      ; Evaluate the operative once when wrap is called
      (define resolved-operative (eval operative wrap-call-env))
      ((= (q operative) (typeof resolved-operative))
       ()
       (raise "wrap can only be applied to operatives"))
      (vau unevaluated-args wrapped-call-env
        ; Here, the implicit env is the closure environment of this inner vau.
        ; This environment was created when the outer vau was called. (The `do`
        ; doesn't create one; it evaluates in the outer vau's environment.) It
        ; contains `resolved-operative` as well as access to the global
        ; environment. When this inner vau is called, it creates a new
        ; environment extending this closure environment, with
        ; `wrapped-call-env` bound to the calling environment and
        ; `unevaluated-args` bound to the arguments.
        (do
          (define evaluated-args (eval-list unevaluated-args wrapped-call-env))
          (eval (cons resolved-operative evaluated-args) wrapped-call-env))))))

; This version of lambda, like primitive vau, only supports a single expression
; body and doesn't support the (head . tail) style of variadic parameters.
(define lambda
  ; We don't support (head . tail) style of parameters.
  ; But we also don't support multiple expressions in the body of a vau or lambda.
  ; So, (formals body) for us is equivalent to (formals . body) for Kernel except
  ; that our body won't be a list.
  (vau (formals body) env
    (wrap (eval
              ; Kernel uses list* here and its last parameter is a list.
            ; So, in Kernel, this part...
            ;    (list* $vau formals #ignore body)
            ; ...is equivalent to...
            ;    (cons $vau (cons formals (cons #ignore body)))
            ; We use () for #ignored and body is not a list, so our equivalent is:
            (cons vau (cons formals (cons () (cons body ()))))
            env))))

; A version of lambda that supports multiple body expressions
(define lambda*
  (vau operands dyn-env
    (do (define formals (first operands))
        (define body (cons do (rest operands)))
        (wrap (eval (list vau formals () body) dyn-env)))))

; A version of vau that supports multiple body expressions
(define vau*
  (vau operands dyn-env
    (do (define formals (first operands))
        (define env-param (second operands))
        (define body (cons do (rest (rest operands))))
        (eval (list vau formals env-param body) dyn-env))))

; Lambda makes implementing list trivial.
(define list (lambda args args))

; This is the equivalent of Kernel's list*.
; It prepends its arguments to the list that is the final argument.
; The $lambda-based implementation of list* given in the Kernel report doesn't
; look to match the expected behavior in use. It would evaluate its arguments
; multiple times during the recursion, but uses seem to expect that its
; arguments would only be evaluated once. To achieve that, this implementation
; uses an inner fexpr for the recursion. It's defined inside a lambda* so that
; it isn't bound in the top-level environment.
(define prepend
  ((lambda* ()
     (define recurse
       (vau operands _
         ((nil? operands)
          ()
          (do (define head (first operands))
              (define tail (rest operands))
              ((nil? tail)
               head
               (cons head (invoke recurse tail)))))))
     (lambda args (invoke recurse args)))))

(define newline (lambda () (display "\n")))

(define number? (lambda (x) (= (q number) (typeof x))))
(define integer? (lambda (x) (and (number? x) (= 1 (denominator x)))))
(define non-negative-integer? (lambda (x) (and (integer? x) (>= x 0))))
(define string? (lambda (x) (= (q string) (typeof x))))
(define symbol? (lambda (x) (= (q symbol) (typeof x))))
(define list? (lambda (x) (or (nil? x) (= (q cons-cell) (typeof x)))))
(define operative? (lambda (x) (= (q operative) (typeof x))))
(define macro? (lambda (x) (= (q macro) (typeof x))))
(define environment? (lambda (x) (= (q environment) (typeof x))))
(define eof-object? (lambda (x) (= (q eof-object) (typeof x))))

; (when test body ...) evaluates the body when test is true, and returns ()
; otherwise. (unless test body ...) is the opposite. They're macros:
; (when test body ...) expands to (if test (do body ...) ()), with the values
; of if and do rather than their names, and the body is evaluated in the
; calling environment.
(define when
  (macro (vau args _ (list if (first args) (cons do (rest args)) ()))))

(define unless
  (macro (vau args _ (list if (first args) () (cons do (rest args))))))

; Partial application from the left
; (partiall + 1) creates a function that adds 1 to its argument
; (partiall cons 'a) creates a function that conses 'a to its argument
(define partiall
  (lambda args
    (do
      (define func (first args))
      (define partial-args (rest args))
      (unless (operative? func)
        (raise "partiall's first argument must be callable"))
      (lambda remaining-args
        (apply func (append partial-args remaining-args))))))

; Partial application from the right  
; (partialr - 1) creates a function that subtracts 1 from its argument
; (partialr cons '()) creates a function that creates a singleton list
(define partialr
  (lambda args
    (do
      (define func (first args))
      (define partial-args (rest args))
      (unless (operative? func)
        (raise "partialr's first argument must be callable"))
      (lambda remaining-args
        (apply func (append remaining-args partial-args))))))

; A lazy version of partiall that doesn't evaluate its partial arguments
(define partiall-lazy
  (vau args env
    (do
      (define func (eval (first args)
                         env))
      (unless (operative? func)
        (raise "partiall-lazy's first argument must be callable"))
      (define partial-args (rest args))
      (lambda remaining-args
        (apply func (append (eval-list partial-args env)
                            remaining-args))))))

; A lazy version of partialr that doesn't evaluate its partial arguments
(define partialr-lazy
  (vau args env
    (do
      (define func (eval (first args)
                         env))
      (unless (operative? func)
        (raise "partiall-lazy's first argument must be callable"))
      (define partial-args (rest args))
      (lambda remaining-args
        (apply func (append remaining-args (eval-list partial-args env)))))))

; foldl applies a binary function to the elements of a list from left to right
; (foldl + 1 (list 2 3 4)) -> (+ (+ (+ 1 2) 3) 4)
(define foldl
  (lambda* (func init lyst)
    (unless (operative? func)
      (raise "foldl's first argument must be callable"))
    (unless (list? lyst)
      (raise "foldl's second argument must be a list"))
    (define loop
      (lambda (acc remaining)
        ((nil? remaining)
         acc
         (loop (func acc (first remaining))
               (rest remaining)))))
    (loop init lyst)))

; foldr applies a binary function to the elements of a list from right to left
; foldr : (a -> b -> b) -> b -> [a] -> b
; Example: (foldr + (list 1 2 3) 0) => 6
; Example: (foldr cons (list 1 2 3) ()) => (1 2 3)
(define foldr
  (lambda* (func lyst init)
    (unless (operative? func)
      (raise "foldr's first argument must be callable"))
    (unless (list? lyst)
      (raise "foldr's second argument must be a list"))
    (define loop
      (lambda (lyst cont)
        ((nil? lyst)
         (cont init)
         (loop (rest lyst)
               (lambda (acc)
                 (cont (func (first lyst) acc)))))))
    (loop lyst (lambda (x) x))))

(define snoc (lambda (tail head) (cons head tail)))

(define reverse (lambda (lyst)
                  ((list? lyst)
                   (foldl snoc () lyst)
                   (raise "reverse's argument must be a list"))))

; foldl-until is foldl with early termination.
; Before each step, it calls (stop? acc). Once that's true, it returns acc
; without looking at the rest of the list.
; (foldl-until + 0 (list 1 2 3 4) (lambda (acc) (> acc 2))) -> 3
(define foldl-until
  (lambda* (func init lyst stop?)
    (unless (operative? func)
      (raise "foldl-until's first argument must be callable"))
    (unless (list? lyst)
      (raise "foldl-until's third argument must be a list"))
    (unless (operative? stop?)
      (raise "foldl-until's fourth argument must be callable"))
    (define loop
      (lambda (acc remaining)
        ; Nested tests instead of or, which would cost an eval per step.
        ((nil? remaining)
         acc
         ((stop? acc)
          acc
          (loop (func acc (first remaining))
                (rest remaining))))))
    (loop init lyst)))

; foldr-until is foldr with early termination.
; Working from the right, before each step it calls (stop? acc). Once that's
; true, it returns acc without looking at the elements to its left.
; (foldr-until + (list 1 2 3 4) 0 (lambda (acc) (> acc 2))) -> 4
(define foldr-until
  (lambda* (func lyst init stop?)
    (unless (operative? func)
      (raise "foldr-until's first argument must be callable"))
    (unless (list? lyst)
      (raise "foldr-until's second argument must be a list"))
    (unless (operative? stop?)
      (raise "foldr-until's fourth argument must be callable"))
    ; Returning acc instead of calling cont skips the rest of the chain.
    (define loop
      (lambda (lyst cont)
        ((nil? lyst)
         (cont init)
         (loop (rest lyst)
               (lambda (acc)
                 ((stop? acc)
                  acc
                  (cont (func (first lyst) acc))))))))
    (loop lyst (lambda (x) x))))

; unfoldl builds a list from a seed. It's the inverse of foldl.
; Until (stop? seed) is true, it conses (mapper seed) onto an accumulator and
; moves on to (successor seed). This is the accumulator pattern, so the first
; element generated ends up last.
; (unfoldl (lambda (n) (= n 0)) (lambda (n) n) (lambda (n) (- n 1)) 3)
;   -> (1 2 3)
(define unfoldl
  (lambda* (stop? mapper successor seed)
    (unless (operative? stop?)
      (raise "unfoldl's first argument must be callable"))
    (unless (operative? mapper)
      (raise "unfoldl's second argument must be callable"))
    (unless (operative? successor)
      (raise "unfoldl's third argument must be callable"))
    (define loop
      (lambda (seed acc)
        ((stop? seed)
         acc
         (loop (successor seed)
               (cons (mapper seed) acc)))))
    (loop seed ())))

; unfoldr builds a list from a seed. It's the inverse of foldr.
; It's like unfoldl, but the first element generated ends up first.
; This is the accumulate-then-reverse pattern.
; (unfoldr (lambda (n) (= n 0)) (lambda (n) n) (lambda (n) (- n 1)) 3)
;   -> (3 2 1)
(define unfoldr
  (lambda* (stop? mapper successor seed)
    (unless (operative? stop?)
      (raise "unfoldr's first argument must be callable"))
    (unless (operative? mapper)
      (raise "unfoldr's second argument must be callable"))
    (unless (operative? successor)
      (raise "unfoldr's third argument must be callable"))
    (reverse (unfoldl stop? mapper successor seed))))

(define for-each (lambda* (procedure lyst)
                   (unless (operative? procedure)
                     (raise "for-each's first argument must be callable"))
                   (unless (list? lyst)
                     (raise "for-each's second argument must be a list"))
                   (foldl (lambda (_ element) (procedure element))
                       ()
                     lyst)
                   ()))

; Should optionally take a separator?
(define displayln
  (lambda* args
    (for-each display args)
    (newline)))

(define lndisplayln
  (lambda* args
    (newline)
    (apply displayln args)))

(define second (lambda (lyst) (first (rest lyst))))
(define third (lambda (lyst) (first (rest (rest lyst)))))
(define fourth (lambda (lyst) (first (rest (rest (rest lyst))))))

(define last
  (lambda* (lyst)
    (unless (list? lyst)
      (raise "last's argument must be a list"))
    (foldl (lambda (_ element) element)
        ()
      lyst)))

; Returns 0 if not found.
; Otherwise, returns the 1-based index.
(define list-index
  (lambda* (predicate lyst)
    (unless (operative? predicate)
      (raise "list-index's first argument must be a predicate"))
    (unless (list? lyst)
      (raise "list-index's second argument must be a list"))
    ; The accumulator is the count of elements seen so far until one matches.
    ; Then it becomes a list holding the index, which stops the fold.
    (define result
      (foldl-until (lambda (count element)
                     ((predicate element)
                      (list (+ count 1))
                      (+ count 1)))
          0
        lyst
        list?))
    ((list? result)
     (first result)
     0)))

; Example of how cond is transformed into a chain of Church Booleans:
#skip
(cond ((= 2 0) 0)
      ((= 2 1) 1)
      ((= 2 2) 2)
      (else 3))
; or
(cond ((= 2 0) 0) ((= 2 1) 1) ((= 2 2) 2) (else 3))
; becomes
((= 2 0) 0
 ((= 2 1) 1
  ((= 2 2) 2
   3)))
; or
((= 2 0) 0 ((= 2 1) 1 ((= 2 2) 2 3)))
#end

; Example of using bare Church Booleans:
#skip
(cond (false 0)
      (true 1))
; becomes
(false 0 (true 1 ()))
#end

; cond evaluates its clauses in order, stopping at the first whose test is
; true. It's a macro that transforms its clauses into a chain of Church
; Boolean calls, as in the examples above.
; (cond) returns ()
; Each clause must have a test.
; An empty body returns ().
; Multiple expressions are allowed in clause bodies.
; An else clause must be the last clause.
; Every clause is checked when the cond is first evaluated, including clauses
; after the one chosen.
(define cond
  (macro (vau clauses _ (cond-transformer clauses))))

; Transforms cond's clauses into a chain of Church Boolean calls, checking
; each clause. It runs once for each cond combination, so its helper can be
; local.
(define cond-transformer
  (lambda* (clauses)
    (define clause-expansion
      (lambda* (clause more)
        (unless (list? clause)
          (raise "cond clause must be a list"))
        (when (nil? clause)
          (raise "cond clauses must have a test"))
        (define test (first clause))
        (define body (rest clause))
        (define body-expr
          ((nil? body)
           ()
           ((nil? (rest body))
            (first body)
            (cons do body))))
        ((and (symbol? test) (= (q else) test))
         ((nil? more)
          body-expr
          (raise "else clause must be the last clause"))
         (list test body-expr (cond-transformer more)))))
    ((nil? clauses)
     ()
     (clause-expansion (first clauses) (rest clauses)))))

; and operative - short-circuiting logical and
; Returns the first falsy value, or the last value if all are truthy
; Uses Church Boolean evaluation for short-circuiting
(define and
  (vau operands env
    ((nil? operands)
     true  ; Empty and is true
     ((eval (first operands) env)
      (eval (cons and (rest operands)) env)
      false))))

; not operative - logical negation
; Returns the Church Boolean opposite of its argument
(define not
  (vau (operand) env
    (do
      (define val (eval operand env))
      (val false true))))

; (nand operand ...) is (not (and operand ...)), and (nor operand ...) is
; (not (or operand ...)). They're macros that expand to exactly that, so they
; short-circuit in the same way: nand stops at the first false operand and
; nor at the first true one. (nand) is false and (nor) is true.
(define nand (macro (vau operands _ (list not (cons and operands)))))
(define nor (macro (vau operands _ (list not (cons or operands)))))

; (xor operand ...) is true when an odd number of its operands are true. That's
; what chaining two-operand xor from the left gives: (xor a b c) is
; (xor (xor a b) c). (xor) is false. The result depends on every operand, so
; all of them are evaluated, and xor is an ordinary function rather than a
; macro.
(define xor
  (lambda operands
    (foldl (lambda (result operand) (operand (not result) result))
           false
           operands)))

; (xnor operand ...) is (not (xor operand ...)): true when an even number of its
; operands are true. With two operands, that's equivalence. (xnor) is true.
(define xnor (lambda operands (not (apply xor operands))))

(define λ lambda)
(define ∧ and)
(define ∨ or)
(define ¬ not)
(define ⊼ nand)
(define ⊽ nor)
(define ⊻ xor)
(define × *)
(define ÷ /)

(define != (λ (x y) (¬ (= x y))))
(define <> !=)
(define <  (λ (x y)
             ((and (number? x)
                   (number? y))
              (= -1 (<=> x y))
              (raise "< can only be applied to numbers"))))
(define >  (λ (x y)
             ((and (number? x)
                   (number? y))
              (= 1 (<=> x y))
              (raise "> can only be applied to numbers"))))

(define <= (λ (x y) (∨ (< x y) (= x y))))
(define >= (λ (x y) (∨ (> x y) (= x y))))
(define ≤  <=)
(define ≥  >=)

; ×÷∧∨¬≤≥λ
; option + /: ÷
; option + =: ≠
; option + ,: ≤
; option + .: ≥
; option + l: ¬

; Using "Unicode shortcuts" VS Code extension...
; Type backslash character-name shift+space
; \lambda λ
; \not ¬
; \and ∧
; \or ∨
; \neq ≠
; \le ≤
; \ge ≥

; No way to type ×?

(define map
  (lambda* (proc lyst)
    (unless (operative? proc)
      (raise "map's first argument must be callable"))
    (unless (list? lyst)
      (raise "map's second argument must be a list"))
    (unfoldr nil?
             (lambda (remaining) (proc (first remaining)))
             rest
             lyst)))

#skip
; Example let transformation:
(let ((x 10)
      (y 2))
  (displayln (* x y))
  (displayln (/ x y)))
; becomes
((lambda* (x y)
   (displayln (* x y))
   (displayln (/ x y)))
 10 2)
#end

; (let ((name expression) ...) body ...)
; Each binding must be a list of a symbol and one expression.
; let is a macro that transforms its operands into a lambda* call, as in the
; example above, with the value of lambda* rather than its name. The bindings
; are checked when the let is first evaluated.
(define let
  (macro (vau* operands _
    (when (nil? operands)
      (raise "let requires a list of bindings"))
    (define bindings (first operands))
    (unless (list? bindings)
      (raise "let's bindings must be a list"))
    (for-each
      (lambda (binding)
        (cond ((or (not (= (q cons-cell) (typeof binding)))
                   (nil? (rest binding))
                   (not (nil? (rest (rest binding)))))
               (raise "let binding must be a list of a name and an expression"))
              ((not (symbol? (first binding)))
               (raise "let binding's name must be a symbol"))))
      bindings)
    (cons (prepend lambda*
                   (map first bindings)
                   (rest operands))
          (map second bindings)))))

; (pipe name first-expression expression ...)
; Pipelines a value through a sequence of expressions: name is bound to the
; value of the first expression, then to the value of each following
; expression in turn, and the value of the last expression is returned. It's
; a macro that expands to nested lets:
;   (pipe x 10 (+ x 1) (* x 2))
; becomes
;   (let ((x 10)) (let ((x (+ x 1))) (* x 2)))
; which is 22. With only one expression, name isn't bound. Each let is a new
; scope, so name can be rebound at each step, and it isn't bound afterward.
; Ported from https://github.com/fisherro/pipe
(define pipe
  (macro (vau* operands _
    (when (nil? operands)
      (raise "pipe requires a name and at least one expression"))
    (define name (first operands))
    (unless (symbol? name)
      (raise "pipe's name must be a symbol"))
    (define expressions (rest operands))
    (when (nil? expressions)
      (raise "pipe requires a name and at least one expression"))
    (define reversed (reverse expressions))
    (foldl (lambda (body expression)
             (list let (list (list name expression)) body))
           (first reversed)
           (rest reversed)))))

; (pipe-it first-expression expression ...)
; An anaphoric pipe: (pipe-it expression ...) is (pipe it expression ...), so
; it binds the name it, on purpose, for each expression after the first.
(define pipe-it
  (macro (vau* operands _
    (when (nil? operands)
      (raise "pipe-it requires at least one expression"))
    (cons pipe (cons (q it) operands)))))

; (infix expression ...)
; Infix notation, with parentheses for grouping and no precedence:
;   (infix x op y) is (op x y)
;   (infix op x) is (op x), so it can also call a one-argument function
;   (infix x) is x, and (infix (e ...)) is (infix e ...)
; Each operand is handled the same way, so (infix (1 + 2) * (10 - 4)) is
; (* (+ 1 2) (- 10 4)). Anything else, such as 1 + 2 + 3, is an error. The
; whole expression is transformed once, when it's first evaluated.
; Ported from this Scheme macro:
;   (define-syntax infix
;     (syntax-rules ()
;       ((_ (x . y)) (infix x . y))
;       ((_ x op y) (op (infix x) (infix y)))
;       ((_ op x) (op (infix x)))
;       ((_ x) x)))
(define infix
  (macro (vau operands _
    (do
      (define infix-list
        (lambda (elements)
          (cond ((nil? elements)
                 (raise "infix expression must have 1, 2, or 3 elements"))
                ((nil? (rest elements))
                 (infix-element (first elements)))
                ((nil? (rest (rest elements)))
                 (list (first elements) (infix-element (second elements))))
                ((nil? (rest (rest (rest elements))))
                 (list (second elements)
                       (infix-element (first elements))
                       (infix-element (third elements))))
                (else
                 (raise "infix expression must have 1, 2, or 3 elements")))))
      ; A parenthesized element is an infix expression of its own.
      (define infix-element
        (lambda (element)
          ((= (q cons-cell) (typeof element))
           (infix-list element)
           element)))
      (infix-list operands)))))

; apply: The applicative version of invoke
; Takes an applicative and a list of arguments,
; applies the applicative to the arguments
(define apply
  (lambda (applicative arg-list)
    (cond ((not (operative? applicative))
           (raise "apply's first argument must be an applicative"))
          ((not (list? arg-list))
           (raise "apply's second argument must be a list"))
          (else
            (eval (cons applicative (map (lambda (arg) (list q arg)) arg-list))
              (get-current-environment))))))

(define length
  (lambda* (lyst)
    (unless (list? lyst)
      (raise "length's argument must be a list"))
    (foldl (lambda (n element)
             (+ n 1))
        0
      lyst)))

(define nth
  (lambda* (lyst n)
    (unless (list? lyst)
      (raise "nth's first argument must be a list"))
    (unless (and (integer? n)
                 (>= n 0))
      (raise "nth's second argument must be a non-negative integer"))
    (define loop
      (lambda (lyst n)
        ((nil? lyst)
         (raise "nth: index out of bounds")
         ((= n 0)
          (first lyst)
          (loop (rest lyst)
                (- n 1))))))
    (loop lyst n)))

(define any?
  (lambda* (predicate lyst)
    (unless (operative? predicate)
      (raise "The first argument to any? must be a predicate"))
    (unless (list? lyst)
      (raise "The second argument to any? must be a list"))
    (foldl-until (lambda (_ element) (predicate element))
        false
      lyst
      (lambda (found?) found?))))

(define all?
  (lambda* (predicate lyst)
    (unless (operative? predicate)
      (raise "The first argument to all? must be a predicate"))
    (unless (list? lyst)
      (raise "The second argument to all? must be a list"))
    (foldl-until (lambda (_ element) (predicate element))
        true
      lyst
      (lambda (all-so-far?) (not all-so-far?)))))

(define append (lambda* lists
                 (unless (all? list? lists)
                   (raise "the arguments to append must all be lists"))
                 ; Fold from the right so each list is copied only once.
                 (foldr (lambda (lyst appended)
                          (foldr cons lyst appended))
                     lists
                   ())))

(define filter (lambda* (predicate lyst)
                 (unless (operative? predicate)
                   (raise "filter's first argument must be callable predicate"))
                 (unless (list? lyst)
                   (raise "filter's second argument must be a list"))
                 (foldl (lambda (accumulator element)
                          ((predicate element)
                           (cons element accumulator)
                           accumulator))
                     ()
                   (reverse lyst))))

(define iota
  (lambda* (count)
    (unless (number? count)
      (raise "iota's argument must be a number"))
    (define predecessor (lambda (n) (- n 1)))
    (unfoldl (lambda (n) (<= n 0))
             predecessor
             predecessor
             count)))

; Q&D test of even?: (map even? (map (lambda (x) (- x 9)) (iota 19)))
(define even? (lambda* (x)
                ((integer? x)
                 (= 0 (remainder x 2))
                 (raise "even? can only be applied to integers"))))

(define odd? (lambda (x)
               ((integer? x)
                (not (even? x))
                (raise "odd? can only be applied to integers"))))

(define abs (lambda (x)
              ((< x 0)
               (- 0 x)
               x)))

(define modulo (lambda (x y)
                 (let ((r (remainder x y)))
                   ((= r 0)
                    0
                    ((< (* r y) 0)
                     (+ r y)
                     r)))))

(define drop
  (lambda* (n lyst)
    (unless (and (integer? n)
                 (>= n 0))
      (raise "drop's first argument must be a non-negative integer"))
    (unless (list? lyst)
      (raise "drop's second argument must be a list"))
    (define loop
      (lambda (n lyst)
        ((or (nil? lyst)
             (<= n 0))
         lyst
         (loop (- n 1)
               (rest lyst)))))
    (loop n lyst)))

(define take
  (lambda* (n lyst)
    (unless (and (integer? n)
                 (>= n 0))
      (raise "take's first argument must be a non-negative integer"))
    (unless (list? lyst)
      (raise "take's second argument must be a list"))
    ; The seed is the count still to take consed onto the remaining list.
    (unfoldr (lambda (seed)
               (or (<= (first seed) 0)
                   (nil? (rest seed))))
             second
             (lambda (seed)
               (cons (- (first seed) 1)
                     (rest (rest seed))))
             (cons n lyst))))

(define string-length (lambda (s) (length (string->list s))))

(define string-append
  (lambda strings
    (list->string (apply append (map string->list strings)))))

(define strings->string
  (lambda (strings)
    (apply string-append strings)))

(define string-nth
  (lambda (s n)
    (list->string (list (nth (string->list s)
                             n)))))

; Maybe a helper for lambda argument validation?
(define check
  (lambda (val pred msg)
    ((pred val)
     val
     (raise msg))))

(define clamp
  (lambda (input lower higher)
    (cond ((< input lower)
           lower)
          ((> input higher)
           higher)
          (else input))))

(define substring
  (lambda* args
    (define nargs (length args))
    (unless (or (= nargs 2)
                (= nargs 3))
      (raise "must have 2 or 3 args"))
    (define lyst (string->list (check (first args)
                                      string?
                                      "1st arg must be a string")))
    (define len (length lyst))
    (define start (clamp (check (second args)
                                non-negative-integer?
                                "start must be a non-negative integer")
                         0
                         len))
    (define dropped (drop start lyst))
    (define end ((= nargs 2)
                 len
                 (clamp (check (third args)
                               non-negative-integer?
                               "3rd arg must be a non-negative integer")
                        start
                        len)))
    (list->string ((= end len)
                   dropped
                   (take (- end start)
                         dropped)))))

(define string->codepoint-strings
  (lambda (s)
    (cond ((not (string? s))
           (raise "string->codepoint-strings' argument must be a string"))
          (else
            (map list->string (map list (string->list s)))))))

; Integer division:
(define quotient
  (lambda (x y)
    (/ (- x (remainder x y)) y)))

; Convert Unicode codepoints to UTF-8 byte values
; Takes a list of numbers representing Unicode codepoints
; Returns a list of numbers representing UTF-8 bytes
(define codepoints->utf8
  (lambda* (codepoints)
    (unless (list? codepoints)
      (raise "codepoints->utf8's argument must be a list"))
    (define encode-codepoint
      (lambda* (cp)
        (unless (and (integer? cp)
                     (>= cp 0)
                     (<= cp #x10FFFF)
                     (not (and (>= cp #xD800) (<= cp #xDFFF))))
          (raise "Invalid Unicode codepoint"))
        (cond ((<= cp #x7F)
               ; 1-byte sequence: 0xxxxxxx
               (list cp))
              ((<= cp #x7FF)
               ; 2-byte sequence: 110xxxxx 10xxxxxx
               (list (+ #xC0 (quotient cp 64))
                     (+ #x80 (remainder cp 64))))
              ((<= cp #xFFFF)
               ; 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
               (list (+ #xE0 (quotient cp 4096))
                     (+ #x80 (remainder (quotient cp 64) 64))
                     (+ #x80 (remainder cp 64))))
              (else
                ; 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                (list (+ #xF0 (quotient cp 262144))
                      (+ #x80 (remainder (quotient cp 4096) 64))
                      (+ #x80 (remainder (quotient cp 64) 64))
                      (+ #x80 (remainder cp 64)))))))
    (apply append (map encode-codepoint codepoints))))

; Convert UTF-8 byte values to Unicode codepoints
; Takes a list of numbers representing UTF-8 bytes
; Returns a list of numbers representing Unicode codepoints
(define utf8->codepoints
  (lambda* (bytes)

    ; Helper function to validate a UTF-8 continuation byte
    (define valid-continuation-byte?
      (lambda* (byte)
        (and (>= byte #x80) (<= byte #xBF))))

    ; Helper function to decode a 1-byte UTF-8 sequence
    (define decode-1-byte
      (lambda* (b1 remaining)
        (cons b1 remaining)))

    ; Helper function to decode a 2-byte UTF-8 sequence
    (define decode-2-byte
      (lambda* (b1 remaining)
        (cond ((nil? remaining)
               (raise "Incomplete UTF-8 sequence"))
              (else
                (do
                  (define b2 (first remaining))
                  (define rest-remaining (rest remaining))
                  (unless (valid-continuation-byte? b2)
                    (raise "Invalid UTF-8 continuation byte"))
                  (define cp (+ (* (- b1 #xC0) 64)
                                (- b2 #x80)))
                  (unless (>= cp #x80)
                    (raise "Overlong UTF-8 encoding"))
                  (cons cp rest-remaining))))))

    ; Helper function to decode a 3-byte UTF-8 sequence
    (define decode-3-byte
      (lambda* (b1 remaining)
        (cond ((nil? remaining)
               (raise "Incomplete UTF-8 sequence"))
              (else
                (do
                  (define b2 (first remaining))
                  (define remaining2 (rest remaining))
                  (cond ((nil? remaining2)
                         (raise "Incomplete UTF-8 sequence"))
                        (else
                          (do
                            (define b3 (first remaining2))
                            (define rest-remaining (rest remaining2))
                            (unless (and (valid-continuation-byte? b2)
                                         (valid-continuation-byte? b3))
                              (raise "Invalid UTF-8 continuation byte"))
                            (define cp (+ (* (- b1 #xE0) 4096)
                                          (* (- b2 #x80) 64)
                                          (- b3 #x80)))
                            (unless (>= cp #x800)
                              (raise "Overlong UTF-8 encoding"))
                            (when (and (>= cp #xD800) (<= cp #xDFFF))
                              (raise "UTF-8 encoding of surrogate codepoint"))
                            (cons cp rest-remaining)))))))))

    ; Helper function to decode a 4-byte UTF-8 sequence
    (define decode-4-byte
      (lambda* (b1 remaining)
        (cond ((nil? remaining)
               (raise "Incomplete UTF-8 sequence"))
              (else
                (do
                  (define b2 (first remaining))
                  (define remaining2 (rest remaining))
                  (cond ((nil? remaining2)
                         (raise "Incomplete UTF-8 sequence"))
                        (else
                          (do
                            (define b3 (first remaining2))
                            (define remaining3 (rest remaining2))
                            (cond ((nil? remaining3)
                                   (raise "Incomplete UTF-8 sequence"))
                                  (else
                                    (do
                                      (define b4 (first remaining3))
                                      (define rest-remaining (rest remaining3))
                                      (unless (and (valid-continuation-byte? b2)
                                                   (valid-continuation-byte? b3)
                                                   (valid-continuation-byte? b4))
                                        (raise "Invalid UTF-8 continuation byte"))
                                      (define cp (+ (* (- b1 #xF0) 262144)
                                                    (* (- b2 #x80) 4096)
                                                    (* (- b3 #x80) 64)
                                                    (- b4 #x80)))
                                      (unless (>= cp #x10000)
                                        (raise "Overlong UTF-8 encoding"))
                                      (unless (<= cp #x10FFFF)
                                        (raise "Codepoint beyond Unicode range"))
                                      (cons cp rest-remaining))))))))))))

    ; Helper function to process one UTF-8 sequence and return (codepoint . remaining-bytes)
    (define decode-one-utf8-sequence
      (lambda* (bytes)
        (cond ((nil? bytes)
               (cons () ()))
              (else
                (do
                  (define b1 (first bytes))
                  (define remaining (rest bytes))
                  (unless (and (integer? b1) (>= b1 0) (<= b1 255))
                    (raise "Invalid byte value"))
                  (cond ((<= b1 #x7F)
                         (decode-1-byte b1 remaining))
                        ((<= b1 #xBF)
                         (raise "Invalid UTF-8 sequence"))
                        ((<= b1 #xDF)
                         (decode-2-byte b1 remaining))
                        ((<= b1 #xEF)
                         (decode-3-byte b1 remaining))
                        ((<= b1 #xF7)
                         (decode-4-byte b1 remaining))
                        (else
                          (raise "Invalid UTF-8 leading byte"))))))))

    (unless (list? bytes)
      (raise "utf8->codepoints's argument must be a list"))
    ; The seed is the result of decoding one sequence:
    ; (codepoint . remaining-bytes)
    ; Decoding no bytes gives a codepoint of (), which ends the unfold.
    (unfoldr (lambda (decoded) (nil? (first decoded)))
             first
             (lambda (decoded) (decode-one-utf8-sequence (rest decoded)))
             (decode-one-utf8-sequence bytes))))

(define countdown
  (lambda (n)
    ((number? n)
     ((<= n 0)
      ()
      (do (displayln n)
          (countdown (- n 1))))
     (raise "countdown's argument must be a number"))))

(define factorial
  (lambda* (n)
    (unless (number? n)
      (raise "factorial can only be calculated for numbers"))
    (unless (>= n 0)
      (raise "factorial is only defined for non-negative integers"))
    (define iter
      (lambda (n acc)
        ((<= n 0)
         acc
         (iter (- n 1)
               (* n acc)))))
    (iter n 1)))

(define fibonacci
  (lambda* (n)
    (unless (number? n)
      (raise "fibonacci can only be calculated for numbers"))
    (unless (>= n 0)
      (raise "fibonacci is only defined for non-negative integers"))
    (define iter
      (lambda (n a b)
        ((<= n 0)
         a
         (iter (- n 1) b (+ a b)))))
    (iter n 0 1)))
