;------------------------------------------------------------------------------
; Environment isolation tests
(lndisplayln "environment isolation tests")

; do and try don't create environments, so definitions made in them remain
(do (define do-defined-var 1))
(test-assert
    (= do-defined-var 1)
  "a definition made in do should remain after it")

(try (do (define defined-before-error 200)
         (rest "invalid"))
  (lambda* (error) "caught"))
(test-assert
    (= defined-before-error 200)
  "a definition made in try before an error should remain after it")

(test-assert
    (not (any? (lambda (name) (= name (q let-scoped-var)))
               (do (let () (define let-scoped-var 1) let-scoped-var)
                   (environment-names (get-current-environment)))))
  "a definition made in let should not remain after it")

; Test exception in environment parameter usage
(define env-error-vau (vau (expr) _ (eval expr "not-an-env")))
(test-error (env-error-vau (+ 1 2)) "invalid environment usage should throw")

;------------------------------------------------------------------------------
; Rebinding tests
(lndisplayln "rebinding tests")

; The message of the error expr raises
(define rebind-error
  (vau (expr) env
    (try (eval expr env)
         (lambda (e) (second e)))))

(define bound-once 1)
(test-assert
    (= (rebind-error (define bound-once 2))
       "define: bound-once is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "define should not rebind a name in the same environment")

(test-assert
    (= bound-once 1)
  "a failed define should leave the binding as it was")

(test-assert
    (= (rebind-error (define-mutable bound-once 2))
       "define-mutable: bound-once is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "define-mutable should not rebind a name in the same environment")

(define-mutable mutable-bound-once 1)
(test-assert
    (= (rebind-error (define mutable-bound-once 2))
       "define: mutable-bound-once is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "define should not rebind a mutable name in the same environment")

(set! mutable-bound-once 2)
(test-assert
    (= mutable-bound-once 2)
  "set! should still change a mutable binding")

(test-assert
    (= (let () (define bound-once 3) bound-once) 3)
  "define should shadow a name bound in an enclosing environment")

(test-assert
    (= (rebind-error redefine) "Unbound variable: redefine")
  "redefine should only be available in the REPL")

;------------------------------------------------------------------------------
; Environment introspection tests
(lndisplayln "environment introspection tests")

(define builtins-names (environment-names (get-builtins-environment)))
(define top-level-names (environment-names (get-top-level-environment)))
(define names-include?
  (lambda (names name)
    (any? (lambda (n) (= n name)) names)))

(test-assert
    (and (names-include? builtins-names (q vau))
         (names-include? builtins-names (q environment-names))
         (not (names-include? builtins-names (q map))))
  "the builtins environment should hold the builtins but not the library")

(test-assert
    (and (names-include? top-level-names (q map))
         (not (names-include? top-level-names (q vau))))
  "the top-level environment should hold the library but not the builtins")

(test-assert
    (not (names-include? top-level-names (q recurse)))
  "prepend's recurse helper should not be bound in the top-level environment")

(test-assert
    (nil? (environment-parent (get-builtins-environment)))
  "the builtins environment should have no parent")

(test-assert
    (= (environment-names (environment-parent (get-top-level-environment)))
       builtins-names)
  "the top-level environment's parent should be the builtins environment")

; Each test file is loaded in its own scope, within the library tests'
; environment, within the top-level environment.
(test-assert
    (= (environment-names
         (environment-parent (environment-parent (get-current-environment))))
       top-level-names)
  "the library tests should run within the top-level environment")

(test-assert
    (= ((lambda* (b a)
          (define c 3)
          (environment-names (get-current-environment)))
        1 2)
       (list (q a) (q b) (q c)))
  "environment-names should list an environment's own bindings, sorted")

(test-assert
    (environment? (environment-parent (get-current-environment)))
  "environment-parent should return an environment")

(test-assert
    (= (try (environment-names 5) (lambda (e) (second e)))
       "environment-names: argument must be an environment, got 5")
  "environment-names should reject a non-environment")

(test-assert
    (= (try (environment-parent) (lambda (e) (second e)))
       "environment-parent: expected 1 argument, got 0")
  "environment-parent should require one argument")

(test-assert
    (= (try (get-builtins-environment 1) (lambda (e) (second e)))
       "get-builtins-environment: expected 0 arguments, got 1")
  "get-builtins-environment should take no arguments")


;------------------------------------------------------------------------------
; let tests
(lndisplayln "let tests")

; Test 1: Basic let with single binding
(test-assert
    (= (let ((x 10)) x) 10)
  "let should work with single binding")

; Test 2: let with multiple bindings
(test-assert
    (= (let ((x 5) (y 3)) (+ x y)) 8)
  "let should work with multiple bindings")

; Test 3: let with no bindings (should work like immediate lambda invocation)
(test-assert
    (= (let () 42) 42)
  "let with empty bindings should work")

; Test 4: let bindings shadow outer variables
(define outer-let-var 100)
(test-assert
    (= (let ((outer-let-var 20)) outer-let-var) 20)
  "let bindings should shadow outer variables")

(test-assert
    (= outer-let-var 100)
  "let should not affect outer variable bindings")

; Test 5: let with complex expressions in bindings
(test-assert
    (= (let ((a (+ 2 3)) (b (* 4 5))) (+ a b)) 25)
  "let should evaluate complex expressions in bindings")

; Test 6: let with multiple body expressions (since let uses lambda*)
(define-mutable let-side-effect 0)
(define let-result
  (let ((x 10))
    (set! let-side-effect 1)
    (set! let-side-effect (+ let-side-effect x))
    (* x 2)))
(test-assert
    (= let-result 20)
  "let should return value of last expression")

(test-assert
    (= let-side-effect 11)
  "let should execute all body expressions for side effects")

; Test 7: Nested let expressions
(test-assert
    (= (let ((x 5))
         (let ((y 3))
           (+ x y))) 8)
  "nested let expressions should work")

; Test 8: let with variable references in bindings (bindings are evaluated in outer scope)
(define let-outer-var 15)
(test-assert
    (= (let ((x let-outer-var) (y 5)) (+ x y)) 20)
  "let bindings should access outer scope variables")

; Test 9: let bindings don't see each other (parallel binding)
(define let-base-var 10)
(test-assert
    (= (let ((x let-base-var) (y let-base-var)) (+ x y)) 20)
  "let bindings should be evaluated independently")

; Test 10: let with conditional expressions
(test-assert
    (= (let ((test-val 5))
         (if (= test-val 5)
           "correct"
           "wrong")) "correct")
  "let should work with conditionals")

; Test 11: let used in function definitions
(define make-adder-with-let
  (lambda (base)
    (lambda (x)
      (let ((adjusted-base (+ base 1)))
        (+ x adjusted-base)))))
(define add-with-six (make-adder-with-let 5))
(test-assert
    (= (add-with-six 10) 16)  ; 10 + (5+1) = 16
  "let should work inside lambda definitions")

; Test 12: let with library functions
(test-assert
    (= (let ((nums (list 1 2 3)))
         (first nums)) 1)
  "let should work with library functions")

; Test 13: let with mutable variables in body
(define-mutable let-mutable-test 0)
(let ((increment 5))
  (set! let-mutable-test increment)
  (set! let-mutable-test (+ let-mutable-test increment)))
(test-assert
    (= let-mutable-test 10)
  "let should work with mutable variable operations")

; Test 14: let with recursive pattern (using library functions)
(test-assert
    (= (let ((double-list (lambda (lst) (map (lambda (x) (* x 2)) lst))))
         (first (double-list (list 3 4 5)))) 6)
  "let should work with higher-order function patterns")

; Test 15: let with Church Boolean results
(define let-boolean-result
  (let ((x 1) (y 1))
    (= x y)))  ; This returns a Church Boolean
; We can't test Church Booleans with = directly, so test their behavior
(test-assert
    (= (let ((test-bool (let ((a 2) (b 2)) (= a b))))
         (test-bool 42 99)) 42)
  "let should work with Church Boolean expressions")

; Test 16: Complex let example with multiple concepts
(define complex-let-result
  (let ((items (list 10 20 30))
        (multiplier 3))
    (define doubled (map (lambda (x) (* x 2)) items))
    (define first-doubled (first doubled))
    (* first-doubled multiplier)))
(test-assert
    (= complex-let-result 60)  ; (10*2)*3 = 60
  "let should work in complex scenarios with multiple operations")

; Test 17: let with string bindings
(test-assert
    (= (let ((greeting "hello") (name "world"))
         greeting) "hello")
  "let should work with string bindings")

; Test 18: let with immediate computation and side effects
(define-mutable let-immediate-effect 0)
(let ((side-effect-val (do (set! let-immediate-effect 42) 10)))
  (set! let-immediate-effect (+ let-immediate-effect side-effect-val)))
(test-assert
    (= let-immediate-effect 52)  ; 42 + 10
  "let bindings should evaluate expressions with side effects immediately")

; Test 19: let error conditions - malformed binding lists
(test-error (let "not-a-list" body) "let should reject non-list binding forms")
(test-error (let ((x)) x) "let should reject incomplete bindings")
#skip
; Need to enhance the let implementation to validate bindings
(test-error (let ((x 1 2)) x) "let should reject malformed bindings")
#end

; Test 20: let with wrapped operatives
(define let-wrapped-op (wrap +))
(test-assert
    (= (let ((op let-wrapped-op) (a 5) (b 7))
         (op a b)) 12)
  "let should work with wrapped operatives")

;------------------------------------------------------------------------------
; let binding validation

; The message of the error expr raises
(define let-error
  (vau (expr) env
    (try (eval expr env)
         (lambda (e) (second e)))))

(test-assert
    (= (let-error (let)) "let requires a list of bindings")
  "let should require a list of bindings")

(test-assert
    (= (let-error (let 5 1)) "let's bindings must be a list")
  "let should reject bindings that aren't a list")

(test-assert
    (= (let-error (let (x) x))
       "let binding must be a list of a name and an expression")
  "let should reject a binding that isn't a list")

(test-assert
    (= (let-error (let ((x)) x))
       "let binding must be a list of a name and an expression")
  "let should reject a binding without an expression")

(test-assert
    (= (let-error (let ((x 1 2)) x))
       "let binding must be a list of a name and an expression")
  "let should reject a binding with more than one expression")

(test-assert
    (= (let-error (let ((1 2)) 3)) "let binding's name must be a symbol")
  "let should reject a binding whose name isn't a symbol")
