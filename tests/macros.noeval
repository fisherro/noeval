(lndisplayln "macro tests")

; The message of the error expr raises
(define error-message
  (vau (expr) env
    (try (eval expr env)
         (lambda (e) (second e)))))

; A when that embeds the if and do values rather than their names
(define my-when
  (macro (vau args _ (list if (first args) (cons do (rest args)) ()))))

(test-assert
    (= (my-when true 1 2) 2)
  "a macro's expansion should be evaluated")

(test-assert
    (nil? (my-when false 1))
  "a macro's expansion should be evaluated for each call")

(define operands-of (macro (vau args _ (list q args))))
(test-assert
    (= (operands-of (+ 1 2) x) (q ((+ 1 2) x)))
  "a macro's transformer should receive the operands unevaluated")

; Evaluating the expansion

(define identity-macro (macro (vau (expr) _ expr)))
(test-assert
    (= (let ((x 5)) (identity-macro x)) 5)
  "an expansion should be evaluated in the calling environment")

(test-assert
    (= (let ()
         (my-when true (define defined-in-expansion 1))
         defined-in-expansion)
       1)
  "a definition in an expansion should bind in the calling environment")

; A macro whose expansion calls it again
(define count-operands
  (macro (vau args _
    ((nil? args)
     0
     (list + 1 (cons count-operands (rest args)))))))
(test-assert
    (= (count-operands a b c) 3)
  "a macro's expansion can call the macro again")

; The transformer's environment

(define transformer-env (macro (vau _ env env)))
(test-assert
    (nil? (environment-names (transformer-env)))
  "a transformer's environment should have no bindings")
(test-assert
    (nil? (environment-parent (transformer-env)))
  "a transformer's environment should have no parent")
(test-assert
    (= (error-message ((macro (vau args env (eval (q +) env)))))
       "Unbound variable: +")
  "a transformer can't look up names in its environment")

; Hygiene

(test-assert
    (= (let ((do 5) (if 6)) (my-when true 1)) 1)
  "an expansion that embeds values should be unaffected by local bindings")

; Duplicate definitions

(define twice (macro (vau (expr) _ (list do expr expr))))
(test-assert
    (= (error-message (let () (twice (define defined-twice 1))))
       "define: defined-twice is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "an expansion that defines a name twice should raise define's error")

; Types

(test-assert
    (= (typeof my-when) (q macro))
  "typeof should return macro for a macro")
(test-assert
    (macro? my-when)
  "macro? should return true for a macro")
(test-assert
    (not (macro? +))
  "macro? should return false for an operative")
(test-assert
    (not (operative? my-when))
  "operative? should return false for a macro")
(test-assert
    (macro? (macro +))
  "macro should accept a builtin operative")

; Errors

(test-assert
    (= (error-message (macro 5)) "macro: argument must be an operative, got 5")
  "macro should reject an argument that isn't an operative")
(test-assert
    (= (error-message (macro)) "macro: expected 1 argument, got 0")
  "macro should reject the wrong number of arguments")
(test-assert
    (= (error-message ((macro (vau args _ (raise "transformer failed")))))
       "transformer failed")
  "an error raised by a transformer should propagate")
(test-assert
    (= (eval my-when (get-current-environment)) my-when)
  "a macro value should evaluate to itself")

; Caching

; A when that counts how many times it has been expanded
(define-mutable expansion-count 0)
(define counted-when
  (macro (vau args _
    (do (set! expansion-count (+ expansion-count 1))
        (list if (first args) (cons do (rest args)) ())))))

(define use-counted-when (lambda (x) (counted-when x 1)))
(use-counted-when true)
(use-counted-when false)
(use-counted-when true)
(test-assert
    (= expansion-count 1)
  "a combination should be expanded only once")

(define use-counted-when-again (lambda (x) (counted-when x 2)))
(use-counted-when-again true)
(test-assert
    (= expansion-count 2)
  "each combination should be expanded separately")

; One combination whose operator is a parameter
(define call-with-true (lambda (m) (m true 1)))
(define my-unless
  (macro (vau args _ (list if (first args) () (cons do (rest args))))))
(test-assert
    (= (call-with-true my-when) 1)
  "a combination should expand with the macro its operator evaluates to")
(test-assert
    (nil? (call-with-true my-unless))
  "a combination should expand again when its operator is a different macro")
(test-assert
    (= (call-with-true (vau args _ (q called))) (q called))
  "a combination should be called normally when its operator isn't a macro")
(test-assert
    (= (call-with-true my-when) 1)
  "a combination should expand again when its operator is a macro again")

; The same combination evaluated where its operator is bound differently
(define rebound-form (q (rebound true 1)))
(test-assert
    (= (let ((rebound my-when)) (eval rebound-form (get-current-environment))) 1)
  "a combination should expand with its operator's binding")
(test-assert
    (nil? (let ((rebound my-unless)) (eval rebound-form (get-current-environment))))
  "a combination should expand again where its operator is bound to another macro")

; Caching mustn't change the forms that code sees as data
(define eval-and-return (vau (x) env (do (eval x env) x)))
(test-assert
    (= (eval-and-return (my-when true 1)) (q (my-when true 1)))
  "a combination should be unchanged after it's expanded")
(test-assert
    (= (first (q (my-when true 1))) (q my-when))
  "a quoted combination shouldn't be expanded")

; A macro should give the same results as the equivalent operative that
; expands its operands on every call. (This one gives the transformer the
; calling environment, which the transformers here ignore.)
(define macro-reference
  (lambda (transformer)
    (vau operands env
      (eval (eval (cons transformer operands) env) env))))

(define when-transformer
  (vau args _ (list if (first args) (cons do (rest args)) ())))
(define reference-when (macro-reference when-transformer))
(define macro-when (macro when-transformer))
(test-assert
    (all? (lambda (test) (= (macro-when test 1 2) (reference-when test 1 2)))
          (list true false))
  "a macro should give the same results as its reference operative")

; Intentional capture
;
; A macro chooses name by name whether to capture: a value in the expansion
; can't be affected by the calling environment, but a symbol is looked up (or
; bound) there.

; An anaphoric macro binds the name it for its body. It embeds the value of
; let but inserts the symbol it.
(define with-it
  (macro (vau args _
    (cons let (cons (list (list (q it) (first args))) (rest args))))))
(test-assert
    (= (with-it (+ 1 2) (* it 10)) 30)
  "an anaphoric macro should bind a name for its body")
(test-assert
    (= (let ((it 5)) (list (with-it 1 it) it)) (list 1 5))
  "an anaphoric macro's binding should only be visible in its body")
(test-assert
    (= (let ((let 5)) (with-it 2 (* it 3))) 6)
  "an anaphoric macro should still embed the values it doesn't capture")

; A macro that refers to a variable of the caller's by name
(define bump!
  (macro (vau () _
    (list set! (q bump-counter) (list + (q bump-counter) 1)))))
(define-mutable bump-counter 0)
(bump!)
(bump!)
(test-assert
    (= bump-counter 2)
  "a macro should be able to refer to a caller's variable by name")
(test-assert
    (and (= (let () (define-mutable bump-counter 100) (bump!) bump-counter) 101)
         (= bump-counter 2))
  "a captured name should be looked up where the macro is used")

; The same combination evaluated in two environments shares an expansion, but
; the captured name is looked up in each.
(define bump-in (lambda (env) (eval (q (bump!)) env)))
(define bump-env-a
  (let () (define-mutable bump-counter 10) (get-current-environment)))
(define bump-env-b
  (let () (define-mutable bump-counter 20) (get-current-environment)))
(bump-in bump-env-a)
(bump-in bump-env-b)
(test-assert
    (and (= (eval (q bump-counter) bump-env-a) 11)
         (= (eval (q bump-counter) bump-env-b) 21))
  "a cached expansion should look up a captured name where it's evaluated")

; A defining macro defines names given as operands in the calling environment.
(define define-pair
  (macro (vau (a b value) _
    (list do (list define a (list first value))
             (list define b (list second value))))))
(test-assert
    (= (let () (define-pair lo hi (list 1 9)) (list lo hi)) (list 1 9))
  "a defining macro should define names in the calling environment")
(test-assert
    (= (error-message
         (let () (define-pair lo hi (list 1 9)) (define-pair lo hi (list 2 8))))
       "define: lo is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "a defining macro should follow define's rule against rebinding")

; A defining macro can make new names from its operands with string->symbol.
; (define-accessors point x y) defines point-x and point-y, which return the
; first and second elements of a list.
(define define-accessors
  (macro (vau (prefix a b) _
    (do
      (define accessor-name
        (lambda (field)
          (string->symbol
            (string-append (symbol->string prefix) "-" (symbol->string field)))))
      (list do
            (list define (accessor-name a) first)
            (list define (accessor-name b) second))))))
(test-assert
    (= (let ()
         (define-accessors point x y)
         (list (point-x (list 3 4)) (point-y (list 3 4))))
       (list 3 4))
  "a defining macro should be able to make new names with string->symbol")

; define-keyword

(define-keyword :test-red :test-green)
(test-assert
    (and (= :test-red (q :test-red)) (= :test-green (q :test-green)))
  "define-keyword should define keywords that evaluate to themselves")
(test-assert
    (= (let () (define-keyword :test-local) (list :test-local)) (list (q :test-local)))
  "define-keyword should define keywords in the calling environment")
(test-assert
    (= (error-message (define-keyword test-blue))
       "define-keyword's names must be symbols starting with :")
  "define-keyword should reject a name that doesn't start with :")
(test-assert
    (= (error-message (define-keyword :))
       "define-keyword's names must be symbols starting with :")
  "define-keyword should reject : on its own")
(test-assert
    (= (error-message (define-keyword 5))
       "define-keyword's names must be symbols starting with :")
  "define-keyword should reject a name that isn't a symbol")
(define-keyword :test-red)
(define-keyword :test-red :test-green)
(test-assert (= :test-red (q :test-red))
  "define-keyword should do nothing for a keyword already defined as itself")
(define-keyword :auto)
(test-assert (= :auto (q :auto))
  "define-keyword should accept a keyword an enclosing environment defines")
(test-assert
    (= (error-message (do (define :test-bob 10) (define-keyword :test-bob)))
       "define-keyword: :test-bob is already defined as something else")
  "define-keyword should reject a keyword bound to something else")
(define :test-outer 5)
(test-assert
    (= (error-message (let () (define-keyword :test-outer)))
       "define-keyword: :test-outer is already defined as something else")
  "define-keyword should reject a keyword an enclosing environment binds to something else")
(test-assert
    (= (error-message (define :test-red (q :test-red)))
       "define: :test-red is already defined in this environment (use set! to change a mutable binding, or let for a new scope)")
  "define should still reject rebinding a keyword")
(define define-keyword-twice (lambda () (define-keyword :test-in-call)))
(define-keyword-twice)
(define-keyword-twice)
(test-assert (not (any? (lambda (name) (= name (q :test-in-call)))
                        (environment-names (get-current-environment))))
  "define-keyword should define a keyword in the calling environment only")
(test-assert
    (and (keyword? (q :test-red)) (keyword? (q :undefined-keyword)))
  "keyword? should be true for a symbol starting with :")
(test-assert
    (and (not (keyword? (q red))) (not (keyword? (q :))) (not (keyword? ":red"))
         (not (keyword? 5)) (not (keyword? (string->symbol ""))))
  "keyword? should be false for anything else")

; gensym

(define gensym-a (gensym))
(define gensym-b (gensym))
(test-assert (and (symbol? gensym-a) (symbol? gensym-b))
  "gensym should return a symbol")
(test-assert (not (= gensym-a gensym-b))
  "gensym should return a different symbol each time")
(test-assert
    (pipe-it (string->list (symbol->string (gensym)))
             (and (= 35 (first it)) (= 58 (second it)) (= 103 (third it))))
  "gensym's symbols should start with #:g")
(test-assert
    (and (= (take 5 (string->list (symbol->string (gensym "tmp"))))
            (string->list "#:tmp"))
         (= (take 6 (string->list (symbol->string (gensym (q loop)))))
            (string->list "#:loop")))
  "gensym should take a prefix as a string or a symbol")
(test-assert
    (= (error-message (gensym 5)) "gensym's prefix must be a string or a symbol")
  "gensym should reject a prefix that isn't a string or a symbol")
(test-assert
    (= (error-message (gensym "a" "b")) "gensym takes at most one argument, a prefix")
  "gensym should reject more than one argument")

; A swap! that binds a temporary with gensym works even when the user's
; variable has the name a fixed temporary would have.
(define gensym-swap!
  (macro (vau (a b) _
    (do (define tmp (gensym "tmp"))
        (list let (list (list tmp a))
              (list set! a b)
              (list set! b tmp))))))
(define-mutable tmp 1)
(define-mutable swap-other 2)
(gensym-swap! tmp swap-other)
(test-assert (and (= tmp 2) (= swap-other 1))
  "a macro's gensym temporary shouldn't capture the user's names")
